{% doc %}
  Renders premium product title, price, variants, purchase form, and tabs.
  @param {product} product - Current product.
  @param {section} section - Owning section.
{% enddoc %}
{% assign variant = product.selected_or_first_available_variant %}
{% assign highlight = product.metafields.custom.product_highlight.value | default: product.metafields.custom.product_highlight %}
<div class="premium-product__info">
  {% if section.settings.show_highlight and highlight != blank %}<div class="premium-product__highlight">{{ highlight }}</div>{% endif %}
  <h1 class="premium-product__title">{{ product.title | escape }}</h1>
  {% render 'premium-product-price', variant: variant, show_sale_badge: section.settings.show_sale_badge, sale_badge_format: section.settings.sale_badge_format %}
  {% render 'premium-product-variant-picker', product: product, section: section %}
  <product-form-component data-section-id="{{ section.id }}" data-product-id="{{ product.id }}" data-product-url="{{ product.url }}" on:submit="/handleSubmit">
    <div class="visually-hidden" aria-live="assertive" role="status" aria-atomic="true" ref="liveRegion"></div>
    {% assign premium_product_form_id = 'PremiumProductForm-' | append: section.id %}
    {% form 'product', product, id: premium_product_form_id, data-type: 'add-to-cart-form' %}
      <input type="hidden" name="id" value="{{ variant.id }}" ref="variantId" data-variant-id-input>
      {% if section.settings.show_quantity %}<label class="premium-product__quantity">Quantity <input type="number" name="quantity" value="{{ variant.quantity_rule.min | default: 1 }}" min="{{ variant.quantity_rule.min | default: 1 }}" {% if variant.quantity_rule.max %}max="{{ variant.quantity_rule.max }}"{% endif %} step="{{ variant.quantity_rule.increment | default: 1 }}"></label>{% else %}<input type="hidden" name="quantity" value="1">{% endif %}
      <add-to-cart-component ref="addToCartButtonContainer" data-add-to-cart-animation="{{ settings.add_to_cart_animation }}">
        <button class="premium-product__add add-to-cart-button button" type="submit" name="add" ref="addToCartButton" on:click="/handleClick" data-add-to-cart {% unless variant.available %}disabled{% endunless %}>
          <span data-add-label>{% if variant.available %}Add to cart{% else %}Sold out{% endif %}</span>
        </button>
      </add-to-cart-component>
      {% comment %} {{ form | payment_button }} {% endcomment %}
    {% endform %}
  </product-form-component>
  {% if section.settings.show_tabs %}{% render 'premium-product-tabs', section: section %}{% endif %}
</div>
{% render 'add-to-cart-button-styles' %}
