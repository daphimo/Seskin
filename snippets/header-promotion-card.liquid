{% doc %}
  Renders a promotional card assigned to a top-level header menu item.

  @param {block} promotion - The header promotion section block.
  @param {string} [sizes] - Responsive image sizes.

  @example
  {% render 'header-promotion-card', promotion: block, sizes: '(min-width: 990px) 240px, 70vw' %}
{% enddoc %}

{% liquid
  assign promotion_url = promotion.settings.url
  assign has_content = false
  if promotion.settings.image != blank or promotion.settings.title != blank or promotion.settings.description != blank
    assign has_content = true
  endif
%}

{% if has_content %}
  <article class="header-promotion" {{ promotion.shopify_attributes }}>
    {% if promotion_url != blank %}<a class="header-promotion__link" href="{{ promotion_url }}">{% endif %}
      {% if promotion.settings.image != blank %}
        {{ promotion.settings.image
          | image_url: width: 720
          | image_tag:
            class: 'header-promotion__image',
            widths: '180, 240, 360, 480, 720',
            sizes: sizes,
            loading: 'lazy'
        }}
      {% endif %}
      {% if promotion.settings.title != blank %}
        <h3 class="header-promotion__title">{{ promotion.settings.title | escape }}</h3>
      {% endif %}
      {% if promotion.settings.description != blank %}
        <p class="header-promotion__description">{{ promotion.settings.description | escape }}</p>
      {% endif %}
    {% if promotion_url != blank %}</a>{% endif %}
  </article>
{% endif %}

{% stylesheet %}
  .header-promotion {
    min-width: 0;
  }

  .header-promotion__link {
    color: inherit;
    text-decoration: none;
  }

  .header-promotion__image {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    background: var(--color-foreground-muted);
  }

  .header-promotion__title {
    margin: var(--padding-sm) 0 0;
    font: inherit;
    font-weight: 600;
  }

  .header-promotion__description {
    margin: var(--padding-3xs) 0 0;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
    line-height: 1.35;
    white-space: normal;
  }
{% endstylesheet %}
