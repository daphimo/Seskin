{% comment %}
  Splide-powered premium product collection carousel.
  Add the section, select a collection, and configure its responsive card count.
{% endcomment %}

{{ 'splide.min.css' | asset_url | stylesheet_tag }}

{% liquid
  assign chosen_collection = section.settings.collection
  assign collection_heading = section.settings.heading | default: chosen_collection.title
%}

<section
  class="premium-collection premium-featured-collection section section--page-width"
  style="--premium-collection-padding-top: {{ section.settings.padding }}px; --premium-collection-padding-bottom: {{ section.settings.padding_bottom }}px; --premium-collection-title-size: {{ section.settings.heading_size }}px;"
>
  {% if chosen_collection != blank %}
    <premium-collection-slider
      data-desktop-items="{{ section.settings.columns_desktop }}"
      data-mobile-items="{{ section.settings.columns_mobile }}"
      data-slide-gap="{{ section.settings.slide_gap }}"
    >
      <div
        class="splide premium-collection__slider"
        data-custom-splide
        data-splide-transition="slide"
        data-splide-loop="false"
        data-splide-arrows="{{ section.settings.show_arrows }}"
        data-splide-previous-label="{{ 'accessibility.slideshow_previous' | t | escape }}"
        data-splide-next-label="{{ 'accessibility.slideshow_next' | t | escape }}"
        aria-label="{{ collection_heading | escape }}"
      >
        <header class="premium-collection__header">
          {% if collection_heading != blank %}
            <h2>{{ collection_heading | escape }}</h2>
          {% endif %}
          {% if section.settings.show_arrows %}
            <div class="splide__arrows premium-collection__controls">
              <button
                class="splide__arrow splide__arrow--prev"
                type="button"
                aria-label="{{ 'accessibility.slideshow_previous' | t | escape }}"
              >
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M7.82843 10.9999H20V12.9999H7.82843L13.1924 18.3638L11.7782 19.778L4 11.9999L11.7782 4.22168L13.1924 5.63589L7.82843 10.9999Z"></path>
                </svg>
              </button>
              <button
                class="splide__arrow splide__arrow--next"
                type="button"
                aria-label="{{ 'accessibility.slideshow_next' | t | escape }}"
              >
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M16.1716 10.9999L10.8076 5.63589L12.2218 4.22168L20 11.9999L12.2218 19.778L10.8076 18.3638L16.1716 12.9999H4V10.9999H16.1716Z"></path>
                </svg>
              </button>
            </div>
          {% endif %}
        </header>

        <div class="splide__track premium-collection__track">
          <ul class="splide__list premium-collection__list" role="list">
            {% for card_product in chosen_collection.products limit: section.settings.product_limit %}
              <li class="splide__slide premium-collection__slide">
                {% render 'premium-product-card', product: card_product, section_id: section.id %}
              </li>
            {% endfor %}
          </ul>
        </div>
      </div>
    </premium-collection-slider>
  {% endif %}
</section>

{% schema %}
{
  "name": "t:names.featured_collection",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "t:settings.collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "t:content.heading_size",
      "min": 16,
      "max": 64,
      "step": 1,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "t:settings.products",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 12
    },
    {
      "type": "header",
      "content": "t:content.carousel"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "t:settings.columns",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:settings.mobile_columns",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "slide_gap",
      "label": "t:settings.slide_spacing",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "t:content.arrows",
      "default": true
    },
    {
      "type": "header",
      "content": "t:settings.padding"
    },
    {
      "type": "range",
      "id": "padding",
      "label": "t:settings.padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:settings.padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "t:names.featured_collection"
    }
  ]
}
{% endschema %}
