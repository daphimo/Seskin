{% comment %}Merchant-configurable contact method cards.{% endcomment %}
{{ 'contact-page.css' | asset_url | stylesheet_tag }}
<section class="contact-page contact-methods color-{{ section.settings.color_scheme }}" style="--contact-methods-padding-top: {{ section.settings.padding_top }}px; --contact-methods-padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="contact-page__inner contact-methods__grid">
    {% for block in section.blocks %}
      {% liquid
        assign card_url = block.settings.url
        if block.settings.action_type == 'email' and block.settings.email != blank
          assign card_url = block.settings.email | prepend: 'mailto:'
        endif
      %}
      <article class="contact-method-card" {{ block.shopify_attributes }}>
        {% if block.settings.badge != blank %}<span class="contact-method-card__badge">{{ block.settings.badge | escape }}</span>{% endif %}
        <span class="contact-method-card__icon" aria-hidden="true">
          {% case block.settings.icon %}
            {% when 'email' %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m4 7 8 6 8-6"></path></svg>
            {% when 'location' %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"></path><circle cx="12" cy="10" r="2.5"></circle></svg>
            {% else %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M21 11.5a8.3 8.3 0 0 1-9 8.2 9.8 9.8 0 0 1-4.2-1L3 20l1.3-4.3A8.3 8.3 0 1 1 21 11.5Z"></path><path d="M8 11.5h.01M12 11.5h.01M16 11.5h.01"></path></svg>
          {% endcase %}
        </span>
        <h2 class="contact-method-card__heading">{{ block.settings.heading | escape }}</h2>
        {% if block.settings.description != blank %}<div class="contact-method-card__description rte">{{ block.settings.description }}</div>{% endif %}
        {% if card_url != blank and block.settings.link_label != blank %}<a class="contact-method-card__link" href="{{ card_url | escape }}">{{ block.settings.link_label | escape }}</a>{% endif %}
      </article>
    {% endfor %}
  </div>
</section>
{% schema %}
{"name":"Contact methods","tag":"section","class":"section-wrapper","max_blocks":6,"settings":[{"type":"color_scheme","id":"color_scheme","label":"Color scheme","default":"scheme-1"},{"type":"range","id":"padding_top","label":"Top padding","min":24,"max":120,"step":4,"unit":"px","default":40},{"type":"range","id":"padding_bottom","label":"Bottom padding","min":24,"max":120,"step":4,"unit":"px","default":40}],"blocks":[{"type":"method","name":"Contact method","settings":[{"type":"text","id":"badge","label":"Badge"},{"type":"select","id":"icon","label":"Icon","options":[{"value":"chat","label":"Chat"},{"value":"email","label":"Email"},{"value":"location","label":"Location"}],"default":"chat"},{"type":"text","id":"heading","label":"Heading","default":"Contact us"},{"type":"richtext","id":"description","label":"Description"},{"type":"select","id":"action_type","label":"Action type","options":[{"value":"link","label":"Page or integration link"},{"value":"email","label":"Email"}],"default":"link"},{"type":"url","id":"url","label":"Link","visible_if":"{{ block.settings.action_type == 'link' }}"},{"type":"text","id":"email","label":"Email address","visible_if":"{{ block.settings.action_type == 'email' }}"},{"type":"text","id":"link_label","label":"Link label","default":"Contact us"}]}],"presets":[{"name":"Contact methods","blocks":[{"type":"method"},{"type":"method"},{"type":"method"}]}]}
{% endschema %}
