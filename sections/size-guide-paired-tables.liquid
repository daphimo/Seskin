{% comment %}
  Side-by-side comparison tables that stack on narrow screens.
  @example
  <!-- Use once for paired regional or cup/band conversions. -->
{% endcomment %}

<section class="size-guide size-guide--paired section color-{{ section.settings.color_scheme }}" style="padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;">
  <div class="size-guide__inner">
    {% if section.settings.heading != blank %}<h2 class="size-guide__heading">{{ section.settings.heading | escape }}</h2>{% endif %}
    {% if section.settings.description != blank %}<div class="size-guide__lede rte">{{ section.settings.description }}</div>{% endif %}
    <div class="size-guide__tables size-guide__tables--paired">
      {% for block in section.blocks %}
        <div {{ block.shopify_attributes }}>
          {% render 'size-guide-table', title: block.settings.title, description: block.settings.description, columns: block.settings.columns, rows: block.settings.rows, note: block.settings.note, table_id: block.id %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% render 'size-guide-styles' %}

{% schema %}
{
  "name": "Paired size tables",
  "tag": "section",
  "class": "section-wrapper",
  "max_blocks": 2,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Bra size conversion" },
    { "type": "richtext", "id": "description", "label": "Description", "default": "<p>Use your underbust and bust measurements to compare band and cup sizing.</p>" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [
    {
      "type": "table",
      "name": "Comparison table",
      "settings": [
        { "type": "text", "id": "title", "label": "Table title", "default": "Band size" },
        { "type": "text", "id": "description", "label": "Description" },
        { "type": "textarea", "id": "columns", "label": "Column headings", "info": "Separate each heading with a | character.", "default": "Underbust (in)|US|EU|UK" },
        { "type": "textarea", "id": "rows", "label": "Rows", "info": "Use one line per row and separate cells with a | character.", "default": "27–28|32|70|32\n29–30|34|75|34\n31–32|36|80|36\n33–34|38|85|38" },
        { "type": "richtext", "id": "note", "label": "Note" }
      ]
    }
  ],
  "presets": [{ "name": "Paired size tables", "blocks": [{ "type": "table" }, { "type": "table" }] }]
}
{% endschema %}
