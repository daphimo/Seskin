{% comment %}
  Ordering help page with configurable banner, navigation, and animated FAQ content.
  @example
  <!-- Use once in templates/page.ordering.json. -->
{% endcomment %}

{{ 'ordering-page.css' | asset_url | stylesheet_tag }}
{{ 'help-page.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ordering-page.js' | asset_url }}" type="module" fetchpriority="low"></script>

{% liquid
  assign desktop_image = section.settings.banner_image
  assign mobile_image = section.settings.banner_image_mobile | default: desktop_image
  assign current_path = request.path
%}

<section
  class="ordering-page color-{{ section.settings.color_scheme }}"
  style="--ordering-banner-height-desktop: {{ section.settings.banner_height_desktop }}px; --ordering-banner-height-mobile: {{ section.settings.banner_height_mobile }}px; --ordering-banner-position: {{ section.settings.banner_position }}; --ordering-padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="ordering-page__banner">
    {% if desktop_image != blank %}
      <picture>
        {% if section.settings.banner_image_mobile != blank %}
          <source media="(max-width: 749px)" srcset="{{ mobile_image | image_url: width: 550 }} 550w, {{ mobile_image | image_url: width: 750 }} 750w, {{ mobile_image | image_url: width: 1100 }} 1100w" sizes="100vw">
        {% endif %}
        {{ desktop_image | image_url: width: 2400 | image_tag: widths: '750, 1100, 1500, 2000, 2400', sizes: '100vw', loading: 'eager', fetchpriority: 'high', alt: section.settings.banner_alt }}
      </picture>
    {% else %}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
    {% endif %}
  </div>

  <div class="ordering-page__inner">
    <nav class="ordering-page__breadcrumbs" aria-label="{{ section.settings.breadcrumb_label | escape }}">
      <ol class="ordering-page__breadcrumb-list">
        <li><a href="{{ routes.root_url }}">{{ section.settings.home_label | escape }}</a></li>
        <li aria-hidden="true">/</li>
        <li>
          {% if section.settings.help_url != blank %}
            <a href="{{ section.settings.help_url }}">{{ section.settings.help_label | escape }}</a>
          {% else %}
            <span>{{ section.settings.help_label | escape }}</span>
          {% endif %}
        </li>
        <li aria-hidden="true">/</li>
        <li aria-current="page">{{ section.settings.heading | escape }}</li>
      </ol>
    </nav>

    <h1 class="ordering-page__title">{{ section.settings.heading | escape }}</h1>

    <div class="ordering-page__layout">
      {% render 'help-sidebar', blocks: section.blocks, current_path: current_path, label: section.settings.sidebar_label %}

      <div class="ordering-page__content">
        <h2 class="ordering-page__content-title">{{ section.settings.content_heading | escape }}</h2>
        <ordering-accordion-component class="ordering-accordion">
          {% for block in section.blocks %}
            {% if block.type == 'accordion' %}
              {% liquid
                assign trigger_id = 'ordering-trigger-' | append: section.id | append: '-' | append: block.id
                assign panel_id = 'ordering-panel-' | append: section.id | append: '-' | append: block.id
              %}
              <div class="ordering-accordion__item" {{ block.shopify_attributes }}>
                <h3 class="ordering-accordion__heading">
                  <button
                    class="ordering-accordion__trigger"
                    type="button"
                    id="{{ trigger_id }}"
                    aria-expanded="{% if block.settings.expanded %}true{% else %}false{% endif %}"
                    aria-controls="{{ panel_id }}"
                    on:click="/toggle"
                    ref="trigger[]"
                  >
                    <span>{{ block.settings.heading | escape }}</span>
                    <svg class="ordering-accordion__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                      <path d="M11.9999 13.1714L16.9497 8.22168L18.3639 9.63589L11.9999 15.9999L5.63599 9.63589L7.0502 8.22168L11.9999 13.1714Z"></path>
                    </svg>
                  </button>
                </h3>
                <div
                  class="ordering-accordion__panel"
                  id="{{ panel_id }}"
                  role="region"
                  aria-labelledby="{{ trigger_id }}"
                  aria-hidden="{% if block.settings.expanded %}false{% else %}true{% endif %}"
                  {% unless block.settings.expanded %}inert{% endunless %}
                  ref="panel[]"
                >
                  <div class="ordering-accordion__inner rte">{{ block.settings.content }}</div>
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </ordering-accordion-component>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Ordering help page",
  "tag": "section",
  "class": "section-wrapper",
  "limit": 1,
  "settings": [
    { "type": "image_picker", "id": "banner_image", "label": "Desktop banner image" },
    { "type": "image_picker", "id": "banner_image_mobile", "label": "Mobile banner image" },
    { "type": "text", "id": "banner_alt", "label": "Banner alt text", "default": "Models wearing a range of apparel fits" },
    { "type": "range", "id": "banner_height_desktop", "label": "Desktop banner height", "min": 200, "max": 700, "step": 10, "unit": "px", "default": 380 },
    { "type": "range", "id": "banner_height_mobile", "label": "Mobile banner height", "min": 160, "max": 500, "step": 10, "unit": "px", "default": 240 },
    { "type": "select", "id": "banner_position", "label": "Banner focal position", "options": [{ "value": "center center", "label": "Center" }, { "value": "center top", "label": "Top" }, { "value": "center bottom", "label": "Bottom" }], "default": "center center" },
    { "type": "text", "id": "breadcrumb_label", "label": "Breadcrumb accessibility label", "default": "Breadcrumb" },
    { "type": "text", "id": "home_label", "label": "Home label", "default": "Home" },
    { "type": "text", "id": "help_label", "label": "Help label", "default": "Help" },
    { "type": "url", "id": "help_url", "label": "Help page link" },
    { "type": "text", "id": "heading", "label": "Page heading", "default": "Ordering" },
    { "type": "text", "id": "sidebar_label", "label": "Sidebar accessibility label", "default": "Help pages" },
    { "type": "text", "id": "content_heading", "label": "Content heading", "default": "Ordering" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 24, "max": 160, "step": 4, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "navigation",
      "name": "Help navigation link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Help page" },
        { "type": "url", "id": "url", "label": "Link" },
        { "type": "checkbox", "id": "is_current", "label": "Show as current page", "default": false }
      ]
    },
    {
      "type": "accordion",
      "name": "Ordering accordion row",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Ordering question" },
        { "type": "richtext", "id": "content", "label": "Content", "default": "<p>Add the relevant ordering information here.</p>" },
        { "type": "checkbox", "id": "expanded", "label": "Expanded by default", "default": false }
      ]
    }
  ],
  "presets": [{ "name": "Ordering help page" }]
}
{% endschema %}
