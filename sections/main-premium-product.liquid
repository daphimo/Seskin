{% comment %}Independent premium product experience; does not depend on the default main product section.{% endcomment %}
{{ 'main-premium-product.css' | asset_url | stylesheet_tag }}
<script src="{{ 'main-premium-product.js' | asset_url }}" type="module" fetchpriority="high"></script>
{% liquid
  assign model_sizing = product.metafields.custom.model_sizing.value | default: product.metafields.custom.model_sizing
  assign initial_variant = product.selected_or_first_available_variant
%}
<premium-product class="main-premium-product premium-product" data-gallery-option-name="{{ section.settings.gallery_option_name | escape }}" data-sale-format="{{ section.settings.sale_badge_format }}" data-add-label="{{ 'actions.add_to_cart' | t | escape }}" data-sold-out-label="{{ 'content.product_badge_sold_out' | t | escape }}">
  <div class="premium-product__layout" style="--premium-gallery-column: {{ section.settings.gallery_width }}%; --premium-product-gap: {{ section.settings.content_gap }}px; --premium-media-ratio: {{ section.settings.media_ratio }};">
    <div class="premium-product__gallery-column">{% render 'premium-product-gallery', product: product, section: section, model_sizing: model_sizing %}</div>
    {% render 'premium-product-info', product: product, section: section %}
  </div>
  {% if section.settings.show_size_guide %}{% render 'premium-product-size-guide', section: section %}{% endif %}
  <script type="application/json" data-premium-product-json>
    {"initialVariantId":{{ initial_variant.id | json }},"variants":[{% for variant in product.variants %}{"id":{{ variant.id | json }},"options":{{ variant.options | json }},"available":{{ variant.available | json }},"price":{{ variant.price | json }},"priceFormatted":{{ variant.price | money | json }},"compareAt":{{ variant.compare_at_price | default: 0 | json }},"compareFormatted":{{ variant.compare_at_price | money | json }},"savingFormatted":{{ variant.compare_at_price | minus: variant.price | money | json }},"featuredMediaId":{{ variant.featured_media.id | json }}}{% unless forloop.last %},{% endunless %}{% endfor %}]}
  </script>
</premium-product>
{% schema %}
{
  "name":"Main premium product","tag":"section","class":"section-wrapper","settings":[
    {"type":"range","id":"gallery_width","label":"Desktop gallery width","min":40,"max":65,"step":1,"unit":"%","default":50},{"type":"range","id":"content_gap","label":"Column gap","min":0,"max":80,"step":4,"unit":"px","default":24},{"type":"select","id":"media_ratio","label":"Gallery aspect ratio","options":[{"value":"3 / 4","label":"Portrait"},{"value":"1 / 1","label":"Square"},{"value":"4 / 5","label":"Apparel"}],"default":"3 / 4"},
    {"type":"checkbox","id":"show_navigation","label":"Show gallery arrows","default":true},{"type":"checkbox","id":"show_progress","label":"Show gallery progress","default":true},{"type":"checkbox","id":"show_zoom","label":"Show zoom","default":true},{"type":"checkbox","id":"show_wishlist","label":"Show wishlist integration point","default":false},{"type":"checkbox","id":"show_model_sizing","label":"Show model sizing","default":true},
    {"type":"checkbox","id":"show_highlight","label":"Show product highlight","default":true},{"type":"checkbox","id":"show_sale_badge","label":"Show sale badge","default":true},{"type":"select","id":"sale_badge_format","label":"Sale badge format","options":[{"value":"percentage","label":"Percentage off"},{"value":"amount","label":"Amount saved"}],"default":"percentage"},
    {"type":"text","id":"gallery_option_name","label":"Gallery grouping option name","default":"Color"},{"type":"text","id":"size_option_name","label":"Size option name","default":"Size"},{"type":"select","id":"swatch_style","label":"Color option style","options":[{"value":"image","label":"Image swatches"},{"value":"color","label":"Color circles"}],"default":"image"},
    {"type":"checkbox","id":"show_quantity","label":"Show quantity","default":false},{"type":"checkbox","id":"show_size_guide","label":"Show size guide","default":true},{"type":"checkbox","id":"show_tabs","label":"Show product tabs","default":true},
    {"type":"text","id":"size_guide_heading","label":"Size guide heading","default":"Size guide"},{"type":"text","id":"size_tab_primary","label":"Primary size tab","default":"XXS to 4X"},{"type":"text","id":"size_tab_secondary","label":"Secondary size tab","default":"International"},{"type":"richtext","id":"size_guide_description","label":"Size guide description","default":"<p>Use the measurements below to find your preferred fit.</p>"},{"type":"text","id":"size_table_headings","label":"Size table headings","default":"Size|US Numeric|Bust|Waist|Hips","info":"Separate headings with |."},{"type":"richtext","id":"size_guide_note","label":"Size guide note"}
  ],
  "blocks":[
    {"type":"tab","name":"Product tab","settings":[{"type":"text","id":"heading","label":"Heading","default":"Details"},{"type":"checkbox","id":"use_product_description","label":"Use product description","default":false},{"type":"richtext","id":"content","label":"Content"}]},
    {"type":"size_row","name":"Size guide row","settings":[{"type":"text","id":"values","label":"Row values","info":"Size|US Numeric|Bust|Waist|Hips","default":"XS|0–2|31–33|24–26|34–36"}]}
  ],
  "presets":[{"name":"Main premium product"}]
}
{% endschema %}
